# Copy this file to .env.personal-infra and replace every change-me value.

COMPOSE_PROJECT_NAME=mealie
TZ=America/Denver

# Must match the shared network in ../personal-infra/.env.
SHARED_NETWORK_NAME=personal-infra-shared

# Public URL routed by Caddy in ../personal-infra/caddy/Caddyfile.
MEALIE_BASE_URL=https://recipes.grantlonie.com

# Host path included in personal-infra Restic backups.
MEALIE_DATA_DIR=/srv/apps/mealie/data

# Local image name built from this fork.
MEALIE_IMAGE=mealie:personal-infra

# Match the host user/group that should own /srv/apps/mealie/data.
PUID=1000
PGID=1000

ALLOW_SIGNUP=false
LOG_LEVEL=INFO

# Shared Postgres from ../personal-infra.
POSTGRES_SERVER=personal-infra-postgres
POSTGRES_PORT=5432
POSTGRES_DB=mealie
POSTGRES_USER=mealie

# Set this to the same value as MEALIE_POSTGRES_PASSWORD in ../personal-infra/.env.
POSTGRES_PASSWORD=qQBlFnUqbowT-cp6Cuo_gkaH9t2xJlpJOTmB8Jr-bJw
